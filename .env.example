# Names of the variables read by deploy/compose.yml. Copy to .env and fill in the real values there.
# The executor connects with the domain user, not with the instance administrator (Annex G). The values come from
# the .env of csp-infra-postgres and, in qa and main, from its secrets; never commit them.
PG_DATABASE=change-me
AUTH_DB_USER=change-me
AUTH_DB_PASSWORD=change-me
